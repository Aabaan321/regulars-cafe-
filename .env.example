# ─────────────────────────────────────────────────────────────────────────────
#  Regulars — three-tier café demo
#  Copy to .env.local and fill in. Nothing here is required to see Tiers 1–2
#  running locally except DATABASE_URL and DATABASE_ADMIN_URL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
# The app connects as an UNPRIVILEGED role and does `SET LOCAL ROLE` on every
# transaction, so row-level security is genuinely enforced. See
# src/lib/db/client.ts.
DATABASE_URL=postgresql://cafe_app:cafe_dev_password@127.0.0.1:5432/regulars_cafe

# Used only by `npm run db:migrate` and `npm run seed` — needs CREATE EXTENSION
# and CREATE ROLE, so it is a superuser/owner connection.
DATABASE_ADMIN_URL=postgresql://cafe_admin:cafe_admin_password@127.0.0.1:5432/regulars_cafe

# Optional tuning.
# DATABASE_POOL_MAX=10
# Set true behind a transaction-mode connection pooler (it cannot prepare).
# DATABASE_DISABLE_PREPARE=false

# ── Site ─────────────────────────────────────────────────────────────────────
# No trailing slash. Used for canonicals, OG images and emailed links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Secrets ──────────────────────────────────────────────────────────────────
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET signs staff session cookies.
AUTH_SECRET=change-me-to-32-plus-random-characters-0123456789
# TOKEN_SECRET signs manage-booking / confirm-subscription / loyalty links.
TOKEN_SECRET=change-me-to-a-different-32-plus-random-string-abcdef

# ── Email ────────────────────────────────────────────────────────────────────
# log      — nothing leaves the building. Every message is written to the
#            `sent_emails` table and shown in the admin Email log. Use this for
#            the demo: you can open a booking confirmation on stage with no
#            real inbox and no verified domain.
# catchall — actually sends, but every recipient is rewritten to
#            DEMO_EMAIL_CATCH_ALL. The intended recipient is kept and shown.
# live     — sends to the real recipient. Production only.
EMAIL_TRANSPORT=log
DEMO_EMAIL_CATCH_ALL=demo@regulars.ae
EMAIL_FROM=Regulars <hello@regulars.ae>
RESEND_API_KEY=

# ── Stripe — TEST KEYS ONLY ──────────────────────────────────────────────────
# Never put a live key in this project. Test cards are documented in the
# README; 4242 4242 4242 4242 with any future expiry and any CVC succeeds.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret the 24h booking-reminder cron presents as a bearer token.
CRON_SECRET=change-me

# ── Demo ─────────────────────────────────────────────────────────────────────
# Password given to all three seeded staff logins.
DEMO_ADMIN_PASSWORD=RegularsDemo!2026
